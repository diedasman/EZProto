# Theme colors:
# $primary
# $secondary
# $accent
# $foreground
# $background
# $surface
# $error
# $success
# $warning
# $panel
# $boost

Screen {
    layout: vertical;
}

#app_shell {
    height: 1fr;
}

#section_nav {
    height: auto;
    margin: 0 1;
}

.nav_buttons {
    width: auto;
    height: auto;
    border: round $surface;
    # padding: 0 1;
}

.section_button {
    min-width: 0;
    width: auto;
    height: auto;
    margin-right: 0;
    # margin-top: 1;
    # margin-bottom: 1;
    padding: 0 1;
    background: $background;
    color: $foreground;
    border: none;
}

.section_button:hover {
    background: $surface;
}

.section_button:focus {
    background: $surface;
    color: $accent;
    text-style: bold;
}

.section_button_active {
    background: $surface;
    color: $accent;
    text-style: bold;
}

#section_host {
    height: 1fr;
}

.section_view {
    height: 1fr;
    padding: 0 1 1 1;
    overflow: hidden;
}

#welcome_layout {
    height: 1fr;
}

#welcome_panel {
    border: round $surface;
    padding: 2 2;
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
}

#welcome_logo_column {
    # content-align: center middle;
    height: auto;
    width: auto;
    margin-right: 2;
}

#welcome_art {
    width: auto;
    height: auto;
    # margin-bottom: 1;
    # margin-top: 1;
    padding: 1 2;
    color: $accent;
    border: round $primary;
    text-align: center;
}

#welcome_message_column {
    # content-align: center middle;
    height: auto;
    width: 1fr;
    layout: vertical;
    # width: auto;
    # padding: 2 2;
}

#welcome_intro {
    text-align: center;
    margin-bottom: 1;
    border: round $primary;
    padding: 1 1;
}

#welcome_navigation_frame {
    # text-align: center;
    layout: grid;
    grid-size: 2;
    # margin-top: 1;
    border: round $primary;
    padding: 1 1;
    height: auto;
}

#welcome_navigation {
    text-align: center;
    margin-top: 1;
    margin-left: 2;
    # width: auto;
}

#arrow_navigation {
    text-align: center;
    margin-top: 1;
}

#welcome_getting_started {
    text-align: center;
    margin-top: 1;
    border: round $primary;
    padding: 1 1;
}

#welcome_shortcuts {
    border: round $primary;
    padding: 1 1;
    height: auto;
    margin-top: 1;
    # margin-bottom: 1;
    # margin-left: 1;
}

#welcome_intro {
    text-align: center;
}


#settings_layout {
    height: 1fr;
}

#protoboard_layout {
    layout: horizontal;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}



#settings_layout {
    layout: vertical;
    height: 1fr;
    min-height: 0;
    padding: 1 1;
    overflow-y: auto;
}

#settings_panel {
    height: auto;
}

.input_column {
    layout: vertical;
    width: 1fr;
    height: 1fr;
    min-height: 0;
    overflow: hidden;
}

.panel {
    width: 1fr;
    height: 1fr;
    min-height: 0;
    border: round $accent;
    padding: 1 1;
    overflow-y: auto;
    overflow-x: hidden;
}

.action_panel {
    width: 1fr;
    height: auto;
    border: round $panel;
    # padding: 1 1;
    # margin-top: 1;
}

.settings_panel {
    min-height: 12;
}

#form {
    layout: vertical;
    height: auto;
}

#board_name_row {
    layout: grid;
    grid-size: 2;
    grid-columns: 18 1fr;
    grid-gutter: 1 1;
    height: auto;
}

#dimensions_row {
    layout: grid;
    grid-size: 4;
    grid-columns: 18 1fr 18 1fr;
    grid-gutter: 1 1;
    height: auto;
    margin-top: 1;
}

#pitch_row,
#pth_drill_row,
#pad_diameter_row,
#mount_hole_row,
#edge_margin_row,
#rounded_corners_row,
#dfm_options_row {
    layout: grid;
    grid-size: 2;
    grid-columns: 18 1fr;
    grid-gutter: 1 1;
    height: auto;
    margin-top: 1;
}

#pitch_controls {
    layout: horizontal;
    height: auto;
}

#pitch {
    width: 16;
    min-width: 16;
    margin-right: 1;
}

.pitch_preset {
    min-width: 8;
    margin-right: 1;
}

.dfm_option {
    margin-right: 2;
}

.settings_form {
    layout: grid;
    grid-size: 2;
    grid-columns: 20 1fr;
    grid-gutter: 1 1;
    height: auto;
}

# Board parameter field labels
.field_label {
    # content-align: center middle;
    border: round $surface;
    # height: 32;
    padding: 0 2;
}

.settings_label {
    padding-bottom: 1;
}

.button_row {
    # content-align: right middle;
    margin-top: 1;
    height: auto;
}

#buttons {
    content-align: right middle;
    height: auto;
}

#generate {
    width: auto;
    margin-left: 1;
}

#pcbway {
    width: auto;
    margin-left: 1;
}

#reset_form {
    width: auto;
    margin-left: 1;
}

#reset_form_overlay {
    align: center middle;
    background: $background 70%;
    width: 100%;
    height: 100%;
}

#reset_form_dialog {
    width: 64;
    height: auto;
    border: round $error;
    background: $surface;
    padding: 1 2;
}

#reset_form_dialog_title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#reset_form_dialog_message {
    margin-bottom: 1;
}

#reset_form_dialog_actions {
    content-align: center middle;
    height: auto;
}

#summary,
#hint,
#proto_status,
#settings_status,
#user_summary,
#board_preview {
    border: round $primary;
    padding: 1 1;
    height: auto;
    # margin-bottom: 1;
}

#board_name {
    width: 1fr;
}

.preset_active {
    background: $accent;
    color: $background;
}

#board_preview {
    # margin-top: 1;
}

# ----- [ STATUS AND SUMMARY STYLES ] -----
.status_box {
    # margin-bottom: 1;
}

.hidden {
    display: none;
}

.success {
    color: $success;
}

.error {
    color: $error;
}
